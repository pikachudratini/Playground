# Copy this file to ".env" and fill in real values. Never commit ".env".
# Every key is OPTIONAL — when a key is missing, that stage falls back to a
# deterministic mock so the whole pipeline still runs offline.

# Firecrawl — extracts branding assets from a live URL.
# Get one at https://www.firecrawl.dev . Without it, webgen does a plain
# fetch() of the page, and if that fails, synthesizes a brand from the domain.
FIRECRAWL_API_KEY=

# Google Gemini — generates hero visuals + transition art ("Nano Banana 2").
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Override the image model id if your account uses a different name.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image-preview

# Anthropic — powers visual-direction synthesis and HTML improvement.
# Get one at https://console.anthropic.com . Without it, both stages use
# deterministic rule-based logic instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Vercel — deploys the finished static site.
# Create a token at https://vercel.com/account/tokens
VERCEL_TOKEN=
# Optional: deploy into a specific team/scope.
VERCEL_TEAM_ID=
