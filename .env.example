# Copy this file to ".env" and fill in real values. Never commit ".env".

# From @BotFather after /newbot (or /token to view an existing one).
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Comma-separated Telegram numeric user IDs that may talk to the bot.
# Anyone else is silently ignored. Get yours from @userinfobot.
ALLOWED_USER_IDS=123456789

# Folder Claude Code runs inside when answering. Make sure this exists.
# Use a dedicated workspace, not your home directory.
CLAUDE_WORK_DIR=C:\Users\YourName\claude-bot-workspace

# Path or name of the Claude Code CLI. Usually just "claude" if it's on PATH.
CLAUDE_CMD=claude

# Max seconds to wait for a single Claude response before giving up.
CLAUDE_TIMEOUT=300


# ============================================================
# Fig Marketing OS (Next.js app) — copy these into ".env.local"
# ============================================================

# Anthropic API key powering the personalization + chat agents.
# Get one at https://console.anthropic.com/. If left blank, the app
# still runs but falls back to non-AI template content.
ANTHROPIC_API_KEY=

# Model used by the agents. Sonnet balances quality and latency;
# use a Haiku model for faster (cheaper) per-request personalization.
ANTHROPIC_MODEL=claude-sonnet-4-6
